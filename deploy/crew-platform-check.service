[Unit]
OnFailure=crew-ops-failure@%n.service
Description=CREW platform reliability checks
After=crew.service nginx.service postgresql.service

[Service]
Type=oneshot
EnvironmentFile=/etc/crew/crew.env
ExecStart=/bin/bash /opt/crew/deploy/crew-platform-check.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
