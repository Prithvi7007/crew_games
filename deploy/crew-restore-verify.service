[Unit]
OnFailure=crew-ops-failure@%n.service
Description=Verify latest CREW backup by restoring to a scratch database
After=postgresql.service crew-backup.service
Requires=postgresql.service

[Service]
Type=oneshot
EnvironmentFile=/etc/crew/crew.env
ExecStart=/bin/bash /opt/crew/deploy/verify-backup-restore.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups
