[Unit]
Description=CREW security state cleanup
After=postgresql.service

[Service]
Type=oneshot
User=crew
Group=www-data
WorkingDirectory=/opt/crew
EnvironmentFile=/etc/crew/crew.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/crew/.venv/bin/flask --app run.py security-cleanup --event-days 90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
