# CREW v11 production environment — copy values into /etc/crew/crew.env.
CREW_ENV=production
SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHAR_SECRET
CREW_INVITE_CODE=REPLACE_WITH_A_PRIVATE_INVITE_CODE
CREW_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSPHRASE
# Optional but strongly recommended: enable Content Studio two-factor authentication.
# Generate after upgrade with: flask --app run.py generate-admin-totp
CREW_ADMIN_TOTP_SECRET=
DATABASE_URL=postgresql://crew_app:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/crew_prod
SESSION_COOKIE_SECURE=true
SESSION_HOURS=12
ADMIN_SESSION_HOURS=4
TRUSTED_HOSTS=cadacrew.fun,www.cadacrew.fun
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
AUTO_DB_MIGRATE=false
CREW_TIMEZONE=America/New_York
